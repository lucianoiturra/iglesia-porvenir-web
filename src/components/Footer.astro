---
const socialLinks = [
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/iglesia.porvenir.587',
    label: 'Seguinos en Facebook',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/iasdporvenir.amch',
    label: 'Seguinos en Instagram',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@IASDPorvenirAMCH',
    label: 'Ver nuestro canal de YouTube',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="#0D1F2D" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>`,
  },
];
---

<footer class="bg-[#0D1F2D] text-white" role="contentinfo">
  <div class="max-w-[1180px] mx-auto px-6 py-12">
    <div class="flex flex-col items-center gap-6">
      <!-- Church name -->
      <div class="text-center">
        <p class="text-base font-semibold text-white/90">
          Iglesia Adventista del Séptimo Día Porvenir
        </p>
        <p class="text-sm text-white/55 mt-1">
          Porvenir 36, Santiago, Región Metropolitana
        </p>
      </div>

      <!-- Social media -->
      <div class="flex items-center gap-4">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
            class="p-2.5 rounded-full bg-white/10 text-white/75 hover:bg-white/20 hover:text-white transition-colors"
          >
            <Fragment set:html={social.icon} />
          </a>
        ))}
      </div>

      <!-- Divider -->
      <div class="w-full max-w-sm h-px bg-white/10"></div>

      <!-- Credits -->
      <p class="text-xs text-white/40 text-center leading-relaxed">
              © 2026 Iglesia Adventista Porvenir · Proyecto Nuevas Generaciones
      </p>
    </div>
  </div>
</footer>
