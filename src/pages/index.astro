---
import Layout from '@/layouts/Layout.astro';
import RoomCards from '@/components/RoomCards';
import FloorPlan from '@/components/FloorPlan';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import PresupuestoSection from '@/components/sections/PresupuestoSection.astro';
import DonarSection from '@/components/sections/DonarSection.astro';
import HistoriaSection from '@/components/sections/HistoriaSection.astro';

---

<Layout
  title="Proyecto Nuevas Generaciones — Iglesia Adventista Porvenir"
  description="Ayúdanos a transformar una bodega en 7 salas propias para los niños y jóvenes de la Iglesia Adventista Porvenir, Santiago."
>

  <!-- ═══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <HeroSection />

  <!-- ═══════════════════════════════════════════
       EL PROBLEMA
  ══════════════════════════════════════════ -->
  <section id="problema" class="section bg-white" aria-labelledby="prob-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Por qué importa</span>
        <h2 id="prob-title">Los niños de Porvenir necesitan un lugar propio</h2>
        <p>Hoy, los más de 100 niños y jóvenes de nuestra iglesia no tienen dónde ser ellos mismos. Cada sábado dependen de instalaciones prestadas que no les pertenecen.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            icon: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
            titulo: 'Sin espacio propio',
            desc: 'Los niños utilizan instalaciones del colegio adyacente, sin certeza de disponibilidad ni ambientación para su formación cristiana.',
            delay: 'reveal-d1',
          },
          {
            icon: `<circle cx="12" cy="8" r="7"/><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/>`,
            titulo: 'Sin identidad',
            desc: 'Los niños no tienen un lugar que sientan suyo: sin decoración, sin materiales propios, sin el ambiente que necesitan para crecer en la fe.',
            delay: 'reveal-d2',
          },
          {
            icon: `<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>`,
            titulo: 'Sin continuidad',
            desc: 'Depender de instalaciones ajenas es un riesgo permanente. Si esa relación cambia, la iglesia perdería el espacio de un día para otro.',
            delay: 'reveal-d3',
          },
        ].map((card) => (
          <div class={`reveal ${card.delay} rounded-2xl bg-[#F5F5F5] p-8 flex flex-col gap-4`}>
            <div class="w-12 h-12 rounded-xl bg-[#003366]/10 flex items-center justify-center">
              <svg viewBox="0 0 24 24" fill="none" stroke="#003366" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24" aria-hidden="true">
                <Fragment set:html={card.icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-[#003366] mb-2">{card.titulo}</h3>
              <p class="text-[#6B7280] text-sm leading-relaxed">{card.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       LA VISIÓN
  ══════════════════════════════════════════ -->
  <section id="vision" class="section bg-[#003366]" aria-labelledby="vision-title">
    <div class="container">
      <div class="section-header section-dark reveal">
        <span class="eyebrow">La solución</span>
        <h2 id="vision-title">7 salas diseñadas para ellos</h2>
        <p>Una ex bodega de dos pisos está siendo transformada en el primer complejo propio para las nuevas generaciones de la Iglesia Porvenir.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        {[
          { val: '7', lbl: 'salas para cada edad', delay: 'reveal-d1' },
          { val: '+90', lbl: 'niños y jóvenes', delay: 'reveal-d2' },
          { val: '222 m²', lbl: 'superficie construida', delay: 'reveal-d3' },
          { val: '2', lbl: 'pisos remodelados', delay: 'reveal-d4' },
        ].map(({ val, lbl, delay }) => (
          <div class={`reveal ${delay} text-center bg-white/[0.07] border border-white/[0.11] rounded-xl p-6 hover:bg-white/[0.12] transition-colors`} role="listitem">
            <div class="text-4xl sm:text-5xl font-black text-[#93C5FD] mb-2 leading-none">{val}</div>
            <div class="text-sm text-white/75 font-medium">{lbl}</div>
          </div>
        ))}
      </div>
      <p class="reveal text-center text-white/80 max-w-2xl mx-auto leading-relaxed">
        Transformaremos esta ex bodega en un lugar diseñado especialmente para nuestros niños y jóvenes:
        con salas para cada grupo de edad, baños modernos, cocina, acceso para personas con movilidad reducida
        y una escalera nueva y segura. Un espacio permanente que les pertenecerá para siempre.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       LAS SALAS
  ══════════════════════════════════════════ -->
  <section id="salas" class="section bg-[#F5F5F5]" aria-labelledby="salas-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Conoce los espacios</span>
        <h2 id="salas-title">Una sala para cada etapa de la vida</h2>
        <p>Desde los más pequeñitos hasta los jóvenes adultos, cada grupo tendrá un espacio pensado especialmente para ellos. Toca cada sala para ver sus detalles.</p>
      </div>
      <RoomCards client:load />
      <div class="text-center reveal mt-12">
        <a
          href="/galeria"
          class="inline-flex items-center gap-2 bg-[#003366] hover:bg-[#1A78C2] text-white font-semibold px-8 py-3.5 rounded-lg transition-colors"
        >
          Ver galería completa con zoom
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       EXPLORADOR DE PLANTAS
  ══════════════════════════════════════════ -->
  <section id="planos" class="section bg-white" aria-labelledby="planos-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Explora el proyecto</span>
        <h2 id="planos-title">Así está distribuido el espacio</h2>
        <p>Toca cualquier sala para ver sus detalles. Cambiá entre el primer y segundo piso con los botones.</p>
      </div>
      <div class="reveal reveal-d1">
        <FloorPlan client:load />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PRESUPUESTO
  ══════════════════════════════════════════ -->
  <PresupuestoSection />

  <!-- ═══════════════════════════════════════════
       CÓMO DONAR
  ══════════════════════════════════════════ -->
  <DonarSection />

  <!-- ═══════════════════════════════════════════
       HISTORIA & AVANCE
  ══════════════════════════════════════════ -->
  <HistoriaSection />

  <!-- ═══════════════════════════════════════════
       EN VIVO (YouTube preview)
  ══════════════════════════════════════════ -->
  <section id="en-vivo" class="section bg-[#0D1F2D]" aria-labelledby="yt-title">
    <div class="container">
      <div class="section-header section-dark reveal">
        <span class="eyebrow">Conectate con nosotros</span>
        <h2 id="yt-title">Nuestras transmisiones</h2>
        <p>Seguí los programas y cultos de la Iglesia Adventista Porvenir en nuestro canal de YouTube.</p>
      </div>

      <div class="reveal flex flex-col items-center gap-6">
        <!-- YouTube embed -->
        <YouTubeEmbed list="UUVohdxDj7SY23bGss_qLS0w" />

        <a
          href="/transmisiones"
          class="inline-flex items-center gap-2 bg-[#1A78C2] hover:bg-[#1567AA] text-white font-semibold px-8 py-3.5 rounded-lg transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="#0D1F2D" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          Ver todas las transmisiones
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  @keyframes heroBg {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }
</style>
