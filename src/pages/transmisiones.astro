---
import Layout from '@/layouts/Layout.astro';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
import { YouTube } from 'youtube-sr';

const CHANNEL_URL = 'https://www.youtube.com/@IASDPorvenirAMCH';
const STREAMS_URL = 'https://www.youtube.com/@IASDPorvenirAMCH/streams';
const CHANNEL_ID = 'UCVohdxDj7SY23bGss_qLS0w';

let videos: { id: string; title: string; thumbnail: string; publishedAt: string; url: string }[] = [];

try {
  const PLAYLIST_ID = CHANNEL_ID.replace('UC', 'UU');
  const playlist = await YouTube.getPlaylist(`https://www.youtube.com/playlist?list=${PLAYLIST_ID}`);
  
  if (playlist && playlist.videos) {
    videos = playlist.videos.slice(0, 4).map((v) => ({
      id: v.id,
      title: v.title,
      thumbnail: v.thumbnail?.url ?? '',
      publishedAt: '', // youtube-sr playlist doesn't give exact dates
      url: `https://www.youtube.com/watch?v=${v.id}`,
    }));
  }
} catch (e) {
  console.error("YouTube Fetch Error:", e);
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Transmisiones — Iglesia Adventista Porvenir"
  description="Seguí los programas y cultos en vivo e historial de transmisiones de la Iglesia Adventista Porvenir."
>
  <div class="section bg-[#0D1F2D] min-h-[40vh] flex items-center">
    <div class="container text-center text-white">
      <span class="eyebrow" style="color: #93C5FD">Conectate con nosotros</span>
      <h1 class="text-4xl sm:text-5xl font-black mt-3 mb-4">Transmisiones</h1>
      <p class="text-white/70 max-w-xl mx-auto leading-relaxed">
        Seguí los programas y cultos de la Iglesia Adventista Porvenir. Reproducí en YouTube o mirá directamente acá.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a
          href={STREAMS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="white" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
          Ver canal en YouTube
        </a>
        <a
          href={CHANNEL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 border border-white/30 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          Suscribirse
        </a>
      </div>
    </div>
  </div>

  <div class="section bg-white">
    <div class="container">
      {videos.length > 0 ? (
        <>
          <div class="section-header reveal">
            <span class="eyebrow">Últimas transmisiones</span>
            <h2 class="text-3xl font-bold text-[#003366]">Programas recientes</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {videos.map((video, i) => (
              <a
                href={video.url}
                target="_blank"
                rel="noopener noreferrer"
                class={`reveal reveal-d${(i % 3) + 1} group block rounded-xl overflow-hidden border border-[#E5E7EB] hover:shadow-[0_8px_40px_rgba(0,51,102,0.15)] transition-shadow`}
              >
                <div class="relative aspect-video overflow-hidden bg-[#0D1F2D]">
                  <img
                    src={video.thumbnail}
                    alt={video.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                    <div class="w-12 h-12 rounded-full bg-red-600 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                  </div>
                </div>
                <div class="p-4">
                  {video.publishedAt && <p class="text-xs text-[#6B7280] mb-1">{formatDate(video.publishedAt)}</p>}
                  <h3 class="text-sm font-semibold text-[#003366] leading-snug line-clamp-2">{video.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </>
      ) : (
        <>
          <div class="section-header reveal">
            <span class="eyebrow">En vivo y en diferido</span>
            <h2 class="text-3xl font-bold text-[#003366]">Canal de YouTube</h2>
            <p>Todos los programas y cultos disponibles en nuestro canal.</p>
          </div>
          <div class="reveal max-w-3xl mx-auto">
            <div class="aspect-video mb-6">
              <YouTubeEmbed list="UUVohdxDj7SY23bGss_qLS0w" className="w-full h-full" />
            </div>
            <p class="text-center text-sm text-[#6B7280]">
              Para ver todas las transmisiones,{' '}
              <a href={STREAMS_URL} target="_blank" rel="noopener noreferrer" class="text-[#1A78C2] underline">
                visitá nuestro canal de YouTube
              </a>.
            </p>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>
